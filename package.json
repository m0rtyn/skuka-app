{
  "name": "skuka-app",
  "private": true,
  "version": "0.11.0",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "npm run start",
    "build": "vite build && npm run copy-changelog",
    "serve": "vite preview",
    "format": "vite format",
    "test": "vitest",
    "test:debug": "vitest --debug",
    "coverage": "vitest run --coverage",
    "build-functions": "cd functions && npm install && npm run build",
    "new-version": "standard-version",
    "bump": "npm run new-version",
    "analyze": "source-map-explorer 'dist/static/js/*.js'",
    "copy-changelog": "cp CHANGELOG.md public/CHANGELOG.txt",
    "inject-app-version": "export VITE_VERSION=$npm_package_version && VITE_NAME=$npm_package_name && echo \"VITE_VERSION: $VITE_VERSION $npm_package_version\""
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.9.0",
    "date-fns": "^2.30.0",
    "firebase": "^11.10.0",
    "nosleep.js": "^0.12.0",
    "rc-progress": "^3.5.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-firebase-hooks": "^5.1.1",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.9.4",
    "react-swipeable": "^7.0.2",
    "react-tooltip": "^5.30.0",
    "react-transition-group": "^4.4.5",
    "styled-components": "^6.1.19",
    "use-long-press": "^3.3.0",
    "use-sound": "^5.0.0",
    "web-vitals": "^4.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.37.0",
    "eslint-config-code-complexity": "^1.2.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.23",
    "globals": "^16.4.0",
    "husky": "^4.3.8",
    "lint-staged": "^10.5.4",
    "prettier": "^3.6.2",
    "rollup-plugin-visualizer": "^5.14.0",
    "source-map-explorer": "^2.5.3",
    "standard-version": "^9.5.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^6.3.6",
    "vite-plugin-pwa": "^1.0.3",
    "vite-plugin-svgr": "^4.5.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.18.3+sha512.bbd16e6d7286fd7e01f6b3c0b3c932cda2965c06a908328f74663f10a9aea51f1129eea615134bf992831b009eabe167ecb7008b597f40ff9bc75946aadfb08d"
}
